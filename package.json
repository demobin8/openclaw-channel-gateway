{
  "name": "openclaw-channel-gateway",
  "version": "1.0.7",
  "description": "OpenClaw IM channel gateway — bridge Telegram/Discord/WeChat/DingTalk/QQ to any OpenAI-compatible agent API",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ocg": "bin/ocg.cjs"
  },
  "files": [
    "dist",
    "bin",
    "ocg.example.json"
  ],
  "scripts": {
    "dev": "tsx --import ./src/loader.ts src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --import ./dist/loader.js dist/cli.js",
    "cli": "node bin/ocg.cjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "openclaw",
    "gateway",
    "telegram",
    "discord",
    "chatbot",
    "openai",
    "im-bridge"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/demobin8/openclaw-channel-gateway.git"
  },
  "homepage": "https://github.com/demobin8/openclaw-channel-gateway#readme",
  "bugs": {
    "url": "https://github.com/demobin8/openclaw-channel-gateway/issues"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@dingtalk-real-ai/dingtalk-connector": "^0.8.23",
    "@openclaw/qqbot": "^2026.6.6",
    "@tencent-weixin/openclaw-weixin": "^2.4.4",
    "grammy": "^1.34.0",
    "openclaw": "^2026.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0"
  }
}


