{
  "name": "lite-gateway",
  "version": "1.0.0",
  "description": "OpenClaw IM channel gateway — bridge Telegram/Discord to any OpenAI-compatible agent API",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "lite-gateway": "bin/lite-gateway.cjs"
  },
  "files": [
    "dist",
    "bin",
    "lite-gateway.example.json"
  ],
  "scripts": {
    "dev": "tsx --import ./src/loader.ts src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --import ./dist/loader.js dist/cli.js",
    "cli": "node bin/lite-gateway.cjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "openclaw",
    "gateway",
    "telegram",
    "discord",
    "chatbot",
    "openai",
    "im-bridge"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/openclaw/openclaw"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@openclaw/qqbot": "^2026.6.5",
    "grammy": "^1.34.0",
    "openclaw": "^2026.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
